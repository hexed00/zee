local function demorceEnsureIcon(path, b64)
    local ok = false
    pcall(function()
        if isfile and isfile(path) then
            ok = true
            return
        end
        if writefile and getcustomasset then
            local data = nil
            if crypt and crypt.base64decode then
                data = crypt.base64decode(b64)
            elseif base64 and base64.decode then
                data = base64.decode(b64)
            else
                -- pure lua base64 decode fallback
                local b='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
                b64 = b64:gsub('[^'..b..'=]', '')
                data = (b64:gsub('.', function(x)
                    if x == '=' then return '' end
                    local r, f = '', (b:find(x) - 1)
                    for i = 6, 1, -1 do r = r .. (f % 2^i - f % 2^(i-1) > 0 and '1' or '0') end
                    return r
                end):gsub('%d%d%d?%d?%d?%d?%d?%d?', function(x)
                    if #x ~= 8 then return '' end
                    local c = 0
                    for i = 1, 8 do c = c + (x:sub(i,i) == '1' and 2^(8-i) or 0) end
                    return string.char(c)
                end))
            end
            if data then
                writefile(path, data)
                ok = true
            end
        end
    end)
    local asset = ""
    pcall(function()
        if getcustomasset and isfile and isfile(path) then
            asset = getcustomasset(path)
        end
    end)
    return asset
end

